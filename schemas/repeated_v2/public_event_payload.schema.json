{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicEventPayload",
  "$ref": "#/$defs/PublicEventPayload",
  "$defs": {
    "PublicEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "event_index": {
          "type": "integer",
          "minimum": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "observation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "user_message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "affected_entity_hypotheses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "event_id",
        "event_index",
        "hypothesis",
        "confidence",
        "evidence_ids",
        "timestamp",
        "provenance"
      ]
    }
  }
}
