          "items": {
            "additionalProperties": {},
            "type": "object"
          },
          "type": "array"
        },
        "hard_constraints": {
          "items": {
            "additionalProperties": {},
            "type": "object"
          },
          "type": "array"
        },
        "initial_facts": {
          "items": {
            "additionalProperties": {},
            "type": "object"
          },
          "type": "array"
