          "enum": [
            "cope_typed_edit",
            "generic_persistent_edit",
            "full_state_regeneration",
            "full_history_replan",
            "rag_replan",
            "summary_memory_replan",
            "skill_local_replan",
            "classical_execution_monitor",
            "oracle_persistent_update"
