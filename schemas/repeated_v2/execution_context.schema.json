{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionContext",
  "$ref": "#/$defs/ExecutionContext",
  "$defs": {
    "ExecutionContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beliefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BeliefFact"
          }
        },
        "progress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProgressCertificate"
          }
        },
        "continuation": {
          "$ref": "#/$defs/ContinuationState"
        }
      },
      "required": [
        "beliefs",
        "progress",
        "continuation"
      ]
    },
    "BeliefFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "key",
        "value",
        "confidence",
        "evidence_ids",
        "timestamp"
      ]
    },
    "ProgressCertificate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "milestone_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "satisfaction": {
          "type": "string",
          "enum": [
            "unresolved",
            "satisfied",
            "violated",
            "unknown"
          ]
        },
        "verifier_record_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "verified_at_step": {
          "type": "integer",
          "minimum": 0
        },
        "affected_by_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "currently_preserved": {
          "type": "boolean"
        }
      },
      "required": [
        "milestone_id",
        "predicate",
        "arguments",
        "satisfaction",
        "verifier_record_id",
        "evidence_ids",
        "verified_at_step"
      ]
    },
    "ContinuationState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_skill": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "program_counter": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "held_object_hypothesis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumable_suffix": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "controller_state_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at_step": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "active_stage",
        "active_skill",
        "program_counter",
        "held_object_hypothesis",
        "resumable_suffix",
        "controller_state_ref",
        "captured_at_step"
      ]
    }
  }
}
