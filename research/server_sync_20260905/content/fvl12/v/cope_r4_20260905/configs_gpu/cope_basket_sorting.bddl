(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the milk and cream cheese in basket A and the butter in basket B)
  (:regions
    (basket_a_init_region
      (:target living_room_table)
      (:ranges ((-0.27 0.23 -0.25 0.25)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (basket_b_init_region
      (:target living_room_table)
      (:ranges ((-0.01 0.23 0.01 0.25)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (basket_c_init_region
      (:target living_room_table)
      (:ranges ((0.25 0.23 0.27 0.25)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (milk_init_region
      (:target living_room_table)
      (:ranges ((-0.22 -0.20 -0.20 -0.18)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (cream_cheese_init_region
      (:target living_room_table)
      (:ranges ((-0.01 -0.20 0.01 -0.18)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (butter_init_region
      (:target living_room_table)
      (:ranges ((0.20 -0.20 0.22 -0.18)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (contain_region (:target basket_1))
    (contain_region (:target basket_2))
    (contain_region (:target basket_3))
  )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    milk_1 - milk
    cream_cheese_1 - cream_cheese
    butter_1 - butter
    basket_1 basket_2 basket_3 - basket
  )

  (:obj_of_interest
    milk_1
    cream_cheese_1
    butter_1
    basket_1
    basket_2
    basket_3
  )

  (:init
    (On milk_1 living_room_table_milk_init_region)
    (On cream_cheese_1 living_room_table_cream_cheese_init_region)
    (On butter_1 living_room_table_butter_init_region)
    (On basket_1 living_room_table_basket_a_init_region)
    (On basket_2 living_room_table_basket_b_init_region)
    (On basket_3 living_room_table_basket_c_init_region)
  )

  (:goal
    (And
      (In milk_1 basket_1_contain_region)
      (In cream_cheese_1 basket_1_contain_region)
      (In butter_1 basket_2_contain_region)
    )
  )
)
