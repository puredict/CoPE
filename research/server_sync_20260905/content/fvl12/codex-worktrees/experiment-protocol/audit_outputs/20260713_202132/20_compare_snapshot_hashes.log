    status = "MISSING" if file in missing else ("MATCH" if rh == h else "DIFF")
    rows.append(f"{status}\t{file}\torig={h}\tremote={rh}")
(root / "snapshot_compare.tsv").write_text("\n".join(rows) + "\n")
print("\n".join(rows))
