import importlib, json, platform, sys
mods = ["torch", "transformers", "mujoco", "robosuite", "libero"]
info = {"python": sys.version, "platform": platform.platform()}
for name in mods:
    try:
        mod = importlib.import_module(name)
        info[name] = getattr(mod, "__version__", "<no __version__>")
    except Exception as e:
        info[name] = f"ERROR {type(e).__name__}: {e}"
try:
    import torch
    info["torch_cuda_available"] = torch.cuda.is_available()
    info["torch_cuda_version"] = torch.version.cuda
    info["torch_device_count"] = torch.cuda.device_count()
except Exception as e:
    info["torch_cuda_probe_error"] = repr(e)
print(json.dumps(info, indent=2, sort_keys=True))
